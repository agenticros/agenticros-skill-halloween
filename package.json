{
  "name": "@agenticros/halloween",
  "version": "0.1.0",
  "type": "module",
  "description": "Creep or Treat — a stationary AgenticROS porch host. YOLOv8n person detection plus RealSense depth/approach speed make the robot talk or scream while a candy bowl stays at its feet.",
  "keywords": [
    "agenticros",
    "ros2",
    "robotics",
    "halloween",
    "realsense",
    "yolo",
    "depth",
    "audio",
    "human-interaction"
  ],
  "homepage": "https://github.com/agenticros/agenticros-skill-halloween#readme",
  "bugs": {
    "url": "https://github.com/agenticros/agenticros-skill-halloween/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticros/agenticros-skill-halloween.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "agenticros": {
    "id": "halloween",
    "displayName": "Creep or Treat",
    "description": "Stationary porch host. Greets only when YOLO sees a person; depth and approach speed pick the line. Candy bowl at the feet. Never drives.",
    "categories": [
      "human-interaction",
      "audio",
      "vision"
    ],
    "capabilities": [
      {
        "id": "host_trick_or_treat",
        "verb": "host",
        "tool": "start_haunt",
        "description": "Stand still and speak or scream as kids approach the candy bowl. Uses YOLOv8n person detection plus RealSense depth/approach speed. Does not move the base.",
        "interruptible": true,
        "blocks_base": false,
        "requires": ["camera", "depth"],
        "optional": ["audio"],
        "inputs": {},
        "outputs": {
          "ok": { "type": "boolean", "description": "True when the haunt loop is running after the call." }
        }
      }
    ]
  },
  "dependencies": {
    "@agenticros/core": "file:../agenticros/packages/core",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@agenticros/object-detection": "file:../agenticros/packages/object-detection",
    "@agenticros/ros-camera": "file:../agenticros/packages/ros-camera",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "author": "chrismatthieu",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
